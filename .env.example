# Firebase Client (Firebase console > Project settings > General > Your apps > Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional: Realtime Database URL (only needed if you enable Realtime Database in addition to Firestore)
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Firebase Admin SDK — choose ONE of the following two options:
# Option A: Base64-encode the JSON file and paste the single-line string here.
FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=
# Option B: Path to the downloaded service account JSON file (relative to project root).
FIREBASE_SERVICE_ACCOUNT_PATH=

# Superuser (tied to this email, created by the setup script)
SUPERUSER_EMAIL=

# Temporary initial password for the superuser. Remove or unset this after running the setup script.
SUPERUSER_INITIAL_PASSWORD=

# GA4 numeric property ID (Google Analytics > Admin > Property settings > Property ID).
# Required for the admin analytics dashboard. The Firebase service account above must
# also be added as a "Viewer" on the GA4 property.
GA4_PROPERTY_ID=

# Cloud Functions region for callable functions (must match deployed region)
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=us-central1
